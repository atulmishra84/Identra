# Portal (Next.js) — build from repo root:
#   docker build -f deploy/docker/Dockerfile.portal --platform linux/amd64 \
#     --build-arg IDENTRA_GATEWAY_URL=http://identra-api-gateway:8080 \
#     -t $ACR/portal-web:tag .

FROM node:22-alpine AS deps
WORKDIR /app
COPY apps/portal-web/package.json apps/portal-web/package-lock.json* ./
RUN npm install

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/portal-web/ ./
ARG IDENTRA_GATEWAY_URL=http://identra-api-gateway:8080
ENV IDENTRA_GATEWAY_URL=$IDENTRA_GATEWAY_URL
RUN mkdir -p public && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S -g 10001 identra && adduser -S -u 10001 -G identra identra
COPY --from=build /app/public ./public
COPY --from=build --chown=identra:identra /app/.next/standalone ./
COPY --from=build --chown=identra:identra /app/.next/static ./.next/static
USER 10001
EXPOSE 3000
CMD ["node", "server.js"]
