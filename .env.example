IDENTRA_ENV=local
IDENTRA_GATEWAY_URL=http://localhost:8080
IDENTRA_BFF_URL=http://localhost:8090
IDENTRA_DB_URL=jdbc:postgresql://localhost:5432/identra
IDENTRA_DB_USER=identra
IDENTRA_DB_PASSWORD=identra
IDENTRA_REDIS_HOST=localhost
IDENTRA_REDIS_PORT=6379
# Enable Redis cache profile: SPRING_PROFILES_ACTIVE=redis
IDENTRA_TEMPORAL_ENABLED=false
IDENTRA_TEMPORAL_TARGET=127.0.0.1:7233
# OIDC / JWT (set IDENTRA_JWT_REQUIRED=true in staging/prod)
IDENTRA_JWT_REQUIRED=false
IDENTRA_OIDC_ISSUER=
IDENTRA_OIDC_JWKS=
IDENTRA_OIDC_AUDIENCE=identra-api
